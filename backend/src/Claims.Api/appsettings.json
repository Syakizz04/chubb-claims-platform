{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Claims": "Host=localhost;Port=5433;Database=claims;Username=claims;Password=claims"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalMs": 500,
    "BatchSize": 100
  },
  "Seed": {
    "DemoClaims": true
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  }
}
